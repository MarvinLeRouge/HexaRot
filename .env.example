# PostgreSQL
POSTGRES_USER=hexarot
POSTGRES_PASSWORD=hexarot_password
POSTGRES_DB=hexarot

# Backend
PORT=3000
# Required, at least 32 characters, must not be left as this placeholder -
# the app refuses to start otherwise. Generate one with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
JWT_EXPIRES_IN=3600
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:5173
# Both required to run `prisma db seed` - the seed refuses to run without
# them, and refuses this documented placeholder password specifically.
SEED_ADMIN_EMAIL=admin@hexarot.local
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_REAL_ADMIN_PASSWORD