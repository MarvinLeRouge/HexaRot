# Template for /home/mlr/marvinlerouge.dev/hexarot/shared/env/app.env on the VPS (chmod 600).
# Non-secret settings, loaded into the postgres and backend containers through env_file in docker-compose.prod.yml.
# Secrets go to secrets.env (see secrets.env.example), loaded after this file so it wins.
# Local development keeps the root .env and backend/.env (see their .example files).

NODE_ENV=production
PORT=3000
FRONTEND_BASE_URL=https://hexarot.marvinlerouge.dev

# JWT lifetime in seconds (the signing key is in secrets.env)
JWT_EXPIRES_IN=3600

# SMTP (Brevo relay), credentials in secrets.env
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
MAIL_STD_NAME=Hexarot
MAIL_STD_EMAIL=
MAIL_ADMIN_NAME=Admin Hexarot
MAIL_ADMIN_EMAIL=

# Error tracking
SENTRY_ENVIRONMENT=production
