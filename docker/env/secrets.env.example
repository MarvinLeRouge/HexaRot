# Template for /home/mlr/marvinlerouge.dev/hexarot/shared/env/secrets.env on the VPS (chmod 600).
# Loaded into the postgres and backend containers after app.env through env_file in docker-compose.prod.yml.
# Each topic holding a secret is kept whole here (its non-secret keys included). Never commit the real file.
# Local development keeps the root .env and backend/.env (see their .example files).

# Database. POSTGRES_* initialise the postgres container (first start only), DATABASE_URL is read by
# Prisma in the backend: user, password and database name must match in both.
POSTGRES_USER=hexarot
POSTGRES_PASSWORD=
POSTGRES_DB=hexarot
DATABASE_URL=postgresql://hexarot:PASSWORD@postgres:5432/hexarot

# JWT signing key, at least 32 characters (generate with: openssl rand -hex 32)
JWT_SECRET=

# SMTP credentials
SMTP_USERNAME=
SMTP_PASSWORD=

# Single admin account, created once by the seed run of the deploy
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Sentry: leave empty to disable. SENTRY_FRONTEND_DSN must match the VITE_SENTRY_DSN GitHub secret exactly.
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=
