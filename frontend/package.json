    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "markdown-it-attrs": "^5.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
