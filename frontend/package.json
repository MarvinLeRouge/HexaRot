{
  "name": "frontend",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@sentry/vue": "^11.14.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "markdown-it-attrs": "^5.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.8",
